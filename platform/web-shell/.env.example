# Copiar a .env y ajustar. NO subir .env a git.

# URL de Keycloak que ve el navegador del usuario
KEYCLOAK_BROWSER_URL=http://localhost:8081
# URL de Keycloak que ve el contenedor (server-to-server)
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8081

KEYCLOAK_REALM=DEMACYA
KEYCLOAK_CLIENT_ID=demacya-app
KEYCLOAK_CLIENT_SECRET=obtener-de-keycloak

REDIRECT_URI=http://localhost:8000/callback
APP_BASE_URL=http://localhost:8000

# openssl rand -hex 32
SESSION_SECRET=genera-un-secreto-aleatorio
SESSION_COOKIE=demacya_session

# Identidad visible
BRAND=DEMACYA
LOGO_FILE=logo.png
TAGLINE=Ingeniería de automatización industrial

# Servicios externos enlazados desde el menú (opcional).
# Si se define, aparece la sección "Visión" apuntando a la UI de la cámara.
# CAMERA_URL=http://localhost:8090
