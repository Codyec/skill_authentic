# Generado por scaffold.py. No subir .env a git.
# Los valores *_PASSWORD y SESSION_SECRET los rellena el script con secretos aleatorios.

# --- Base de datos ---
POSTGRES_DB=__SLUG__
POSTGRES_USER=__SLUG__
POSTGRES_PASSWORD=__RANDOM__

# --- Administrador de Keycloak (consola http://localhost:__KC_PORT__) ---
# GUARDA esta contraseña: es la única cuenta con control total del sistema de identidad.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=__RANDOM__

# --- Conexión de la app con Keycloak ---
KEYCLOAK_BROWSER_URL=http://localhost:__KC_PORT__
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=__REALM__
KEYCLOAK_CLIENT_ID=__SLUG__-app

# --- App web ---
REDIRECT_URI=http://localhost:__WEB_PORT__/callback
APP_BASE_URL=http://localhost:__WEB_PORT__
SESSION_SECRET=__RANDOM__
SESSION_COOKIE=__SLUG___session

# --- Identidad visible ---
BRAND=__BRAND__
LOGO_FILE=logo.png
TAGLINE=Panel de administración
